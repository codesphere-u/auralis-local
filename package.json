{
  "name": "auralis-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A deliberate, private AI workspace for Apple Silicon.",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "AURALIS_DEV=1 tsx watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "engines": {"node": ">=22.12.0"},
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  }
}
